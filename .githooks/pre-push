#!/usr/bin/env sh
# pre-push — CI の Validate より先に、ローカルで落ちるものを落とす。
#
# なぜ要るか:
#   instrumentation.json の due は UTC の暦日で比較され、due 当日はコードと無関係な
#   push でも Validate の instrumentation job が赤になる（2026-09-07）。その job は
#   先頭で止まるので後続の 7 検査も走らない。
#   文章で「push 前に回す」と書いても検査が緑のときには読まれないので hook にする。
#
# 何をするか:
#   - node scripts/check-instrumentation.mjs（数十 ms）
#   - 削除 push（local sha が全 0）だけのときは素通し
#   以前は push 範囲に .go があるときに staticcheck も回していたが、2026-10-19 に本線を
#   Rust 版へ移し、Go 版は凍結した（ビルドも検査もしない）ので外した。
#
# 逃げ道: MANY_AI_CLI_SKIP_PREPUSH=1 git push ...
#   検査自体の不具合で push できないときだけ使う。CI 側の検査は飛ばないので、
#   赤になるものは結局 CI で止まる。
#
# 手動実行（git push --dry-run は pre-push を呼ばない）:
#   printf 'refs/heads/develop <local sha> refs/heads/develop <remote sha>\n' | sh .githooks/pre-push origin <url>
#
# 正本: .github/workflows/validate.yml（instrumentation job）
# 有効化: core.hooksPath = .githooks（scripts/install-hooks.sh / scripts/install-hooks.ps1）

if [ "${MANY_AI_CLI_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: MANY_AI_CLI_SKIP_PREPUSH=1 のため検査を飛ばします（CI では走ります）"
  exit 0
fi

zero='0000000000000000000000000000000000000000'
pushing=0

# 標準入力: <local ref> <local sha> <remote ref> <remote sha> が push する ref ごとに 1 行。
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  pushing=1
done

if [ "$pushing" -eq 0 ]; then
  exit 0
fi

echo "pre-push: node scripts/check-instrumentation.mjs"
node scripts/check-instrumentation.mjs || {
  echo "pre-push: 観測コードの台帳検査で止めました。撤去するか due を更新してから push してください"
  exit 1
}

exit 0
