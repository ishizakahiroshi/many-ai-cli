    },
    {
      "id": "claim_8ab963ef06e74e5caa41087345b0b776",
      "statement": ".github/workflows/release.yml triggers on pushing a v*.*.* tag or via workflow_dispatch for an npm-only re-publish, and its release job downloads and cosign-verifies a pinned goreleaser binary before running `goreleaser release --clean`, which drives the GitHub Release, winget-pkgs PR, and Homebrew tap publish per .goreleaser.yaml.",
      "evidence": [
