        }
      ]
    },
    {
      "id": "claim_8d8ee529121142d1987d248d8028694c",
      "statement": "Three files (npm/many-ai-cli/package.json, each npm/many-ai-cli-<platform>/package.json, and winres/winres.json) are the only version-bearing files in the repository, and all three are expected to sit stale between releases because CI overwrites them from the pushed git tag on every release rather than a human editing them.",
      "evidence": [
        {
          "resource": "repo://scripts/check-version-sources.mjs#L1-L16",
          "version": "repo-lines-v1:sha256:3f694abcbd60e9e19a2ec9c882d5ff3bb89ac98d40dd5b0006b10a026606aa02:"
        }
      ]
    },
    {
      "id": "claim_78c198597aa04dd5a022ed0e8669e7b7",
      "statement": "scripts/sync-npm-version.mjs syncs npm/many-ai-cli/package.json's version and optionalDependencies plus each platform package's own version, pinning the root package's optionalDependencies to the exact same version so a published root package can never resolve a mismatched platform binary.",
      "evidence": [
        {
          "resource": "repo://scripts/sync-npm-version.mjs#L1-L30",
          "version": "repo-lines-v1:sha256:10f30265a5f65d8b922a4c6b40e89ef43b633b5edb879072d020c99d31a97569:"
        }
      ]
    },
    {
      "id": "claim_c125f9e5e76a4c2f975f7adf234482de",
      "statement": "scripts/check-version-sources.mjs is a CI gate that verifies the release workflow still wires sync-npm-version.mjs (the version-overwriting mechanism) rather than checking whether the in-repo version strings currently match the latest tag, since staleness between releases is the expected correct state.",
      "evidence": [
        {
          "resource": "repo://scripts/check-version-sources.mjs#L1-L17",
          "version": "repo-lines-v1:sha256:b5fa8fde4b6c2ef4a6de3c830474bcaa00415ef5dc0029643883ec690c86b869:"
        }
      ]
    },
    {
      "id": "claim_ed7776d8685d4460ae686e8463f00ee5",
      "statement": "The published many-ai-cli npm package's bin/many-ai-cli.mjs is a thin shim that resolves an OS/arch-specific optionalDependencies package (many-ai-cli-windows-x64/-linux-x64/-macos-intel/-macos-apple-silicon) and execs that package's bundled native binary, forwarding argv, stdio, and the exit code/signal, rather than shipping the binary itself in the root package.",
