    {
      "id": "claim_3edbb5a9502845e4891aa13ffb7f867c",
      "statement": "approval-answered.ts previously split approval identity across three separate state mechanisms (a timer-expiring signature, a permanent full-block-hash mark, and a manual-dismiss question key) with different definitions of 'same question,' and the mismatches between them caused already-answered approvals to reappear; the current design uses exactly one candidateKey + sourceEpoch pair per candidate.",
      "evidence": [
        {
          "resource": "repo://web/src/app/approval-answered.ts#L1-L16",
          "version": "repo-lines-v1:sha256:53c6afa39ae455cf9a420dfb8d668a9f2a5ef86eff3bd61acc43d6b70912e5cc:"
        }
      ]
    },
    {
      "id": "claim_527ce5ea8e6e47bcaa5d39ee7f0c4a5f",
      "statement": "candidateKey is built from provider, approval kind, normalized question text, and sorted optionNumber:sendText pairs, deliberately excluding label whitespace, box-drawing characters, and line-wrap differences so a TUI redraw does not change the key; sourceEpoch is a live-prompt generation counter that replay and terminal reflow do not advance, so an intentional re-ask in a new generation is shown while the same content replayed within the same generation is recognized as already-answered.",
      "evidence": [
