  "claims": [
    {
      "id": "claim_1b28b4815b29471f8d285cbcf994b416",
      "statement": "main() delegates every subcommand to a single run(args) function that switches on args[0] with no subcommand framework; running with zero arguments checks whether a Hub is already running and either opens a browser tab against it or starts a new Hub with auto-open enabled.",
      "evidence": [
        {
          "resource": "repo://cmd/many-ai-cli/main.go#L173-L237",
          "version": "repo-lines-v1:sha256:3fc89b1eea393dce9129f9942ccb68bd26ae80234df942db5640ec99f1a8c0ba:"
        }
      ]
    },
    {
      "id": "claim_8b9df956af3749d1978b1134d867d296",
      "statement": "A top-level deferred recover() in main() catches any panic escaping run() (including the blocking serve path), logs it with a stack trace via the file logger, and exits, so a crash leaves a diagnostic trail in hub.log instead of vanishing silently.",
      "evidence": [
        {
          "resource": "repo://cmd/many-ai-cli/main.go#L75-L111",
          "version": "repo-lines-v1:sha256:52431b29cff076060c9e2ebf38dda87c577b4c733cda541f38bb0dbfc07d6b88:"
        }
      ]
    },
