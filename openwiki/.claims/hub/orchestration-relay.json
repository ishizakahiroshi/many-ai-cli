    {
      "id": "claim_0c88afa3b53c4612ae4c8841c4989409",
      "statement": "relay.go's header comment states the relay's goal is to drive plan -> implementation -> adversarial review -> fix -> next C without an AI conductor deciding any step; the Hub advances the state machine from exactly two signals: the count of ## DONE <role> lines in a child's progress file (a count, not mere presence, so one child can complete several Cs in sequence) and the reviewer's verdict: line, with every side-effecting action routed through an injectable relayDeps interface so the state machine can be unit tested without a real process.",
      "evidence": [
        {
          "resource": "repo://internal/hub/relay.go#L3-L13",
          "version": "repo-lines-v1:sha256:bc41d8f92a132ff4db0c1bc5886232f13f800b49a371fcd1e9d7ff0ebff2535e:"
        }
