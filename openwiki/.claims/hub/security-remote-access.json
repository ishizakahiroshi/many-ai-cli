    {
      "id": "claim_0ea2139a68e549e2b7b843e2b31980a0",
      "statement": "Failed PIN login attempts are rate-limited per IP with exponential backoff (5 failures triggers a 1-minute lockout, escalating to 5 minutes then 30 minutes) plus an overall cap against distributed brute-force attempts, both surfaced as HTTP 429; GET /api/auth/status and POST /api/auth/login go through guardBase (skipping the PIN gate itself), while POST /api/auth/set-pin requires the full PIN-gated guard, meaning a remote caller can only change the PIN once already PIN-authenticated; PIN values, tokens, auth cookies, and failed-PIN input are never written to the structured log.",
      "evidence": [
        {
          "resource": "repo://internal/hub/pin_auth.go#L395-L480",
          "version": "repo-lines-v1:sha256:0b75db97c511afb5bc6632e6a420fc2ef2415e18ef846c5e8ff4c54b01ef5003:"
