    {
      "id": "claim_6453a789942b4b339d7c6dad44794f2b",
      "statement": "internal/sessionstore uses modernc.org/sqlite, a pure-Go SQLite driver, and applies PRAGMA busy_timeout as the first pragma on every new connection specifically because it defaults to 0 (immediate SQLITE_BUSY failure rather than waiting), so any pragma issued before it (such as the WAL-mode pragma issued during init, which creates a -wal file and can contend with another process already holding the database open) would itself fail immediately under lock contention instead of benefiting from the timeout.",
      "evidence": [
        {
          "resource": "repo://internal/sessionstore/store.go#L17-L21",
          "version": "repo-lines-v1:sha256:7eaf26363267b3640614db18531fb337acb5ea65360554b8c5b61d365f6057d2:"
