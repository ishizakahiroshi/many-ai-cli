    {
      "id": "claim_2a0c2dd139c743b7892f6d26e5d45850",
      "statement": "internal/config.SplitCommandLine is the single source of truth for parsing a custom provider's command: string into argv, used identically by internal/wrapper for process launch and internal/doctor for its PATH-existence probe, and its own doc comment requires README.md's Custom providers section to be kept in sync with the same rules.",
      "evidence": [
        {
          "resource": "repo://internal/config/custom_provider_command.go#L8-L14",
          "version": "repo-lines-v1:sha256:da215fcf20acbba620e7a619306162efce8ab4d1b75dceaeef252f7e1fde495c:"
        }
      ]
    },
    {
      "id": "claim_950f6c0e7ed345409e94c93a1f921586",
      "statement": "SplitCommandLine's parsing rules include: space/tab delimit tokens with runs collapsing to one; a double-quoted span can start and end mid-token with the quotes stripped from the result; doubled quotes inside a quoted span decode to one literal quote character; backslash is always a literal character and never an escape; single-quote has no special meaning; environment variables, tilde, globs, and shell operators all pass through as literal text since the string never reaches a shell; and an unterminated quote, a stray control character, or zero resulting tokens are parse errors.",
      "evidence": [
        {
          "resource": "repo://internal/config/custom_provider_command.go#L15-L29",
          "version": "repo-lines-v1:sha256:f1baf2c8cf9fe4dd20354a9c9318c631bd0cf012fa6a99c07b474c6930465eb8:"
        }
      ]
    }
