    {
      "id": "claim_95b14fe7396c439d88fe7a4caad0a151",
      "statement": "Hand-editing custom_providers: in config.yaml is the only way to add, change, or remove a custom provider entry — the Hub UI only displays a configured entry and lets a session spawn with it, and never writes, edits, or deletes one itself.",
      "evidence": [
        {
          "resource": "repo://internal/config/custom_provider.go#L55-L61",
          "version": "repo-lines-v1:sha256:ce25ee5fec7ab79f23ca124426159581e9ada0209df0b9bd588af7ee6022742a:"
        }
      ]
    },
    {
      "id": "claim_4b396fcae3734827b1bc3a84069b7aad",
      "statement": "CustomProviders.UnmarshalYAML decodes tolerantly: a YAML node that fails to decode into a CustomProvider, or that decodes but is missing id or command, is silently dropped rather than failing the whole config file's parse.",
      "evidence": [
