    {
      "id": "claim_3ba1e96892db4825a14a34f28cbf1149",
      "statement": "Built-in-id collision and duplicate-id checks for custom providers happen later in EffectiveCustomProviders/Warnings(), not during UnmarshalYAML, specifically so cfg.CustomProviders still reflects exactly what the user wrote and Save() round-trips a mistyped entry instead of silently deleting it.",
      "evidence": [
