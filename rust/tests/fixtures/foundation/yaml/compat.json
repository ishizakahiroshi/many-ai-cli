  {
    "name": "null-slice-elements",
    "yaml": "token: synthetic-stable-token\nvoice:\n  whisper:\n    hallucination_phrases: [null, 00123, ~, TRUE, 'null', '', 0xFF]\nsubscriptions:\n  claude:\n    - id: work\n      profile_owned_keys: [null, 00123, TRUE, ~, 'null']\n      default_wins_keys: [null, theme]\n",
    "paths": [
      "/token",
      "/voice/whisper/hallucination_phrases",
      "/subscriptions"
    ],
    "expected": {
      "/subscriptions": {
        "claude": [
          {
            "default_wins_keys": [
              "theme"
            ],
            "id": "work",
            "profile_owned_keys": [
              "00123",
              "TRUE",
              "null"
            ]
          }
        ]
      },
      "/token": "synthetic-stable-token",
      "/voice/whisper/hallucination_phrases": [
        "00123",
        "TRUE",
        "null",
        "",
        "0xFF"
      ]
    },
    "saved_has_hallucination_phrases": true
  },
