[
  {
    "name": "string-lexemes-and-octal-int",
    "yaml": "token: 00123\nauth_cookie_secret: 0xFF\nremote_pin_hash: TRUE\nhub: {port: 0123}\n",
    "paths": [
      "/token",
      "/auth_cookie_secret",
      "/remote_pin_hash",
      "/Hub/Port"
    ],
    "expected": {
      "/Hub/Port": 83,
      "/auth_cookie_secret": "0xFF",
      "/remote_pin_hash": "TRUE",
      "/token": "00123"
    },
    "saved_has_hallucination_phrases": false
  },
  {
